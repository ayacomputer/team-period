# ─────────────────────────────────────────────────────────────────────────────
#  .env.example — flutter-skeleton
#
#  【日本語】このファイルを .env にコピーして、実際の値を入力してください。
#  このファイル（.env.example）は git にコミットして OK です。
#  .env は絶対にコミットしないでください — シークレットが漏洩します。
#
#  Windows (PowerShell) でのコピー方法:
#    Copy-Item .env.example .env
#    notepad .env          # または: code .env（VS Code）
#
#  【English】Copy this file to .env and fill in your real values.
#  Keep this file committed. NEVER commit .env — it contains real secrets.
#
#  Mac / Linux (bash):
#    cp .env.example .env && $EDITOR .env
# ─────────────────────────────────────────────────────────────────────────────


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ワークフロー設定 / Workflow config
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 【日本語】GitHub のユーザー名または組織名
# 【English】Your GitHub username or organisation name
GITHUB_ORG=ayacomputer

# 【日本語】アプリのスラッグ（小文字・ハイフン区切り）例: my-app
#           create.sh が自動で設定します
# 【English】Lowercase hyphenated app slug, e.g. my-app (set by create.sh automatically)
APP_NAME=team-period

# 【日本語】固定値です。変更しないでください
# 【English】Fixed — do not change
FRAMEWORK=flutter


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Android アプリ識別情報 / Android app identity
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 【日本語】Android アプリケーション ID（逆ドメイン形式）
#           android/app/build.gradle.kts の applicationId に設定してください
#           例: com.yourcompany.myapp
# 【English】Reverse-domain application ID for Android
#            Set this in android/app/build.gradle.kts as applicationId
#            e.g. com.yourcompany.myapp
ANDROID_APPLICATION_ID=


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  iOS アプリ識別情報 / iOS app identity
#  ※ iOS ビルドは Mac のみ対応です。Android のみ開発する場合はスキップできます。
#  ※ iOS builds require a Mac. Skip this section if you are Android-only.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 【日本語】バンドル ID（逆ドメイン形式）
#           Apple Developer ポータルで登録したものと一致させてください
#           例: com.yourcompany.myapp
# 【English】Reverse-domain bundle ID matching your Apple Developer portal registration
#            e.g. com.yourcompany.myapp
IOS_BUNDLE_IDENTIFIER=

# 【日本語】Apple Developer チーム ID（10文字の英数字）
#           確認方法: https://developer.apple.com/account → Membership Details → Team ID
#           例: AB12CD34EF
# 【English】10-character Apple Developer Team ID
#            Find it: https://developer.apple.com/account → Membership Details → Team ID
APPLE_TEAM_ID=


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Xcode Cloud / App Store Connect API
#  ※ .\f.ps1 build:iosc など Xcode Cloud コマンドを使う場合のみ必要です（Mac のみ）。
#  ※ Only needed for Xcode Cloud commands (Mac only).
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 【日本語】App Store Connect API キーの情報
#           生成場所: https://appstoreconnect.apple.com/access/integrations/api
# 【English】Generate at: https://appstoreconnect.apple.com/access/integrations/api
ASC_KEY_ID=
ASC_ISSUER_ID=

# 【日本語】ダウンロードした .p8 ファイルへのローカルパス
#           絶対にこのファイルを git にコミットしないでください
# 【English】Local path to your downloaded .p8 file — NEVER commit this file
ASC_PRIVATE_KEY_PATH=


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Firebase シークレット / Firebase secrets
#  ※ Firebase を使わない場合はこのセクション全体をスキップできます。
#  ※ Skip this entire section if you are not using Firebase.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 【日本語】Firebase のキーはビルド時に firebase.env.json 経由で注入されます。
#           ここではなく firebase.env.json に値を入力してください。
#
#           firebase.env.json の作成方法（Windows PowerShell）:
#             Copy-Item firebase.env.json.example firebase.env.json
#             notepad firebase.env.json
#
# 【English】Firebase keys are injected at build time via firebase.env.json.
#            Fill in values there, not here.
#
#            Mac / Linux:
#              cp firebase.env.json.example firebase.env.json && $EDITOR firebase.env.json
#
# ⚠️  【日本語】Xcode Cloud 注意: Xcode Cloud の VM では .env は読み込まれません。
#     以下の各変数を Xcode Cloud のワークフロー UI で手動追加してください:
#     App Store Connect → [アプリ] → Xcode Cloud → [ワークフロー] → Edit
#       → Environment → Environment Variables（各キーの "Secret" にチェック）
#
# ⚠️  【English】Xcode Cloud: .env is never available in the Xcode Cloud VM.
#     Add each variable manually in the workflow UI:
#     App Store Connect → [your app] → Xcode Cloud → [workflow] → Edit
#       → Environment → Environment Variables (tick "Secret" for each)

FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_PACKAGE_NAME=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Android 署名 / Android signing
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 【日本語】リリースビルドの署名にはキーストアファイルが必要です。
#           一度生成したら安全な場所に保管してください。
#           紛失すると Play Store でアプリを更新できなくなります。
#
# 【English】You need a keystore file to sign release builds.
#            Generate it once and keep it safe — losing it means you cannot
#            update your app on the Play Store.
#
# ▶ ステップ 1: キーストアを生成する / Step 1: Generate the keystore
#
#   Windows (PowerShell):
#     keytool -genkey -v -keystore release.keystore `
#       -alias my-app -keyalg RSA -keysize 2048 -validity 10000
#     # keytool は JDK に同梱されています。なければ https://adoptium.net からインストール
#     # keytool is bundled with the JDK — install from https://adoptium.net if missing
#
#   Mac / Linux:
#     keytool -genkey -v -keystore release.keystore \
#       -alias my-app -keyalg RSA -keysize 2048 -validity 10000
#
# ▶ ステップ 2: キーストアを base64 に変換して GitHub Secret に登録する
#   Step 2: Encode the keystore to base64 and add it as a GitHub Secret
#
#   【日本語】GitHub Secret はテキストのみ保存できます。
#           バイナリファイル（.keystore）を base64 でテキスト変換してから登録します。
#   【English】GitHub Secrets must be plain text. Base64 encodes the binary
#              keystore file as text so it can be stored and decoded inside CI.
#
#   Windows (PowerShell):
#     [Convert]::ToBase64String([IO.File]::ReadAllBytes("release.keystore")) | Set-Clipboard
#     # クリップボードにコピーされます。GitHub Secret の値欄に貼り付けてください
#     # Copied to clipboard — paste it into the GitHub Secret value field
#
#   Mac / Linux:
#     base64 -i release.keystore | pbcopy

ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  CI オプション設定 / Optional CI overrides
#  ※ 必要な場合のみ、先頭の # を外して値を設定してください。
#  ※ Uncomment and set only if you need to override the defaults.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# FLUTTER_VERSION=          # 空白 = .fvmrc のバージョンを使用 / blank = use version from .fvmrc
# BUILD_TYPE=app-bundle     # app-bundle（Play Store 用）または apk
# EXPORT_OPTIONS_PLIST=.github/ios/ExportOptions.plist
# FLUTTER_BUILD_ARGS=
# FATAL_WARNINGS=false
# WORKING_DIRECTORY=.
